# ==============================================================================
# FOLIO ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================

# Node Environment
NODE_ENV="development"

# 1. DATABASE
# Local development uses SQLite for zero-config out-of-the-box operation:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL (Neon / Supabase / Railway / Docker):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# 2. AUTHENTICATION (NextAuth.js)
NEXTAUTH_URL="http://localhost:3000"
# Generate a secure 32-character secret via: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars-long"

# 3. GOOGLE OAUTH 2.0 (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# 4. GITHUB OAUTH (Optional fallback provider)
GITHUB_ID=""
GITHUB_SECRET=""

# 5. DEVELOPMENT DEMO AUTH (Enables 1-click test login without external OAuth credentials)
# Set to "true" for local development, "false" in production
NEXT_PUBLIC_ENABLE_DEV_MOCK_AUTH="true"
